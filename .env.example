# URL exacte du site déployé (canonical, Open Graph, sitemap).
# Sur Vercel, l'URL est détectée automatiquement via VERCEL_PROJECT_PRODUCTION_URL.
# Si tu veux forcer une URL (ex: domaine personnalisé), décommente et renseigne :
# NEXT_PUBLIC_SITE_URL=https://ton-domaine.vercel.app

# Google Search Console - tag de vérification (optionnel, mis dans le <head>)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend - envoi du formulaire de contact
RESEND_API_KEY=
